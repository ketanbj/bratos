# Existing CloudLab experiment: SSH aliases or user@host, separated by spaces.
# Configure per-node ports/keys in ~/.ssh/config. Normal host-key checking applies.
CLOUDLAB_HOSTS=
CLOUDLAB_REMOTE_DIR=/users/YOUR_USERNAME/bratos-cloudlab
CLOUDLAB_SSH=ssh
CLOUDLAB_RSYNC=rsync
CLOUDLAB_PYTHON=python3
# Worker processes per node. Start small and measure memory before raising this.
CLOUDLAB_CPUS_PER_NODE=1
CLOUDLAB_TIME_LIMIT_SECONDS=3600
CLOUDLAB_POLL_SECONDS=30
CLOUDLAB_STATE_DIR=cloudlab/state
# Leave IDs blank to use the latest run or start a new run.
CLOUDLAB_RUN_ID=
CLOUDLAB_RESUME_RUN_ID=

# Scientific target: every catalog record over approximately one orbit.
# Validate with make smoke before running this full-duration configuration.
ORBITAL_SNAPSHOT=data/orbital_snapshot_full.json
SATELLITES=all
PROVIDERS=starlink,kuiper
SEEDS=1
SERVICE_CELLS=1000
H3_RESOLUTION=5
EPOCHS=1200
EPOCH_SECONDS=5
SIM_WORKERS=0
