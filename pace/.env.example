# PACE connection. Leave PACE_LOGIN blank when commands are run on a PACE
# login node. Remote paths must be absolute (do not use ~).
PACE_LOGIN=
PACE_REMOTE_DIR=/home/USERNAME/bratos
PACE_SSH=ssh
PACE_RSYNC=rsync

# Remote sync is an exact mirror for source files: stale remote source files
# are deleted and a checksum pass must succeed before sbatch is invoked.
# PACE-only state (.venv, .git, job IDs, logs, and results) is protected.

# PACE/SLURM allocation. Account, partition, and QOS may be left blank to use
# site defaults. One task per node splits provider/seed runs across nodes.
# Python worker processes use the CPUs assigned to each task. The current
# seven seeds x two providers give 14 independent CPU jobs. Node count has no
# fixed cap of three; choose more nodes/cores for larger experiment sets.
SBATCH_ACCOUNT=gts-jyoung9-csse
SBATCH_PARTITION=
SBATCH_QOS=
SBATCH_TIME=01:00:00
SBATCH_NODES=1
SBATCH_GPUS_PER_NODE=
SBATCH_CPUS_PER_TASK=14
SLURM_JOB_NAME=bratos
SBATCH_MEM=32G
SBATCH_CONSTRAINT=
SBATCH_EXTRA_ARGS=

# Cluster Python environment. Set PACE_MODULES to the module names needed to
# expose Python >=3.10 on PACE. This module is available on Phoenix.
PACE_MODULES=python/3.11.9
PYTHON_BIN=python3
VENV_ACTIVATE=.venv/bin/activate

# Simulation. Resolution 5 supports up to 2,016,842 cells, but runtime grows
# roughly with cells * satellites * epochs * seeds * providers. Start with a
# short scaling run before requesting a full 1,200-epoch experiment.
SERVICE_CELLS=10000
H3_RESOLUTION=5
EPOCHS=100
EPOCH_SECONDS=5
SATELLITES=96
# Set SATELLITES=all with an unsampled provider catalog; see the Intel profiles.
ORBITAL_SNAPSHOT=data/orbital_snapshot.json
PROVIDERS=starlink,kuiper
SEEDS=7,19,31,43,59,71,89

# 0 uses SLURM_CPUS_PER_TASK, capped internally by the number of seeds.
SIM_WORKERS=0

# Results are written below the repository on PACE. These relative paths are
# resolved from the repository root.
RESULTS_DIR=pace/results
LOG_DIR=pace/logs
LOG_PATTERN=bratos-%j.log
RUNS_DIR=pace/runs

# Use make smoke for a small one-CPU validation job. Configuration may be
# overridden per invocation: make submit SERVICE_CELLS=10000 EPOCHS=100
# CPU-only is the default; leave SBATCH_GPUS_PER_NODE empty.
# Example: make submit SBATCH_NODES=4 SBATCH_CPUS_PER_TASK=4
